{
  "opencollection": "1.0.0",
  "info": {
    "name": "Galileo Public Annotations Integrations API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Galileo-API-Key",
      "value": "{{Galileo-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listAvailableIntegrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.galileo.ai/v2/integrations/available"
          }
        },
        {
          "info": {
            "name": "getIntegration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.galileo.ai/v2/integrations/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "getIntegrationStatus",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.galileo.ai/v2/integrations/:name/status",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}