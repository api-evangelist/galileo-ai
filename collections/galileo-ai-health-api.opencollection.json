{
  "opencollection": "1.0.0",
  "info": {
    "name": "Galileo Public Annotations Health API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Galileo-API-Key",
      "value": "{{Galileo-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "healthcheck",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.galileo.ai/v2/healthcheck"
          }
        }
      ]
    }
  ],
  "bundled": true
}